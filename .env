# База данных (SQLite для локального запуска).
# Для продакшена достаточно заменить на строку подключения PostgreSQL
# и провайдер в prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Секрет для подписи сессионных куки (JWT). В проде замените на длинную случайную строку.
SESSION_SECRET="dev-secret-change-me-please-32-chars-min-0000"
