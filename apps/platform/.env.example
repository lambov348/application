# ─── База данных ────────────────────────────────────────────────────────────
# В docker compose хост — имя сервиса "postgres". Для запуска без Docker
# замените на localhost и свой порт.
DATABASE_URL="postgresql://moebelstock24:CHANGE_ME@postgres:5432/moebelstock24?schema=public"

# ─── Auth.js ────────────────────────────────────────────────────────────────
# Секрет подписи сессий. Сгенерировать: openssl rand -base64 32
AUTH_SECRET=""
# Внешний адрес приложения. Обязателен в продакшене, иначе Auth.js построит
# неверные ссылки за обратным прокси.
AUTH_URL="http://localhost:3000"
# Время жизни сессии в секундах. 8 часов — рабочий день (глава 4 ТЗ:
# «сессии с ограничением по времени»).
SESSION_MAX_AGE_SECONDS="28800"

# ─── Шифрование ─────────────────────────────────────────────────────────────
# Ключ шифрования TOTP-секретов в базе. Ровно 32 байта в base64.
# Сгенерировать: openssl rand -base64 32
# ВНИМАНИЕ: при потере ключа все настроенные 2FA придётся сбрасывать вручную.
ENCRYPTION_KEY=""

# ─── Хранилище файлов ───────────────────────────────────────────────────────
# local — папка на диске (разработка). s3 — S3-совместимое хранилище (продакшен).
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# Заполняется только при STORAGE_DRIVER=s3.
# DSGVO: регион обязан быть в ЕС (Hetzner Object Storage — fsn1, nbg1, hel1).
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Приём заявок с сайта ───────────────────────────────────────────────────
# Общий секрет для подписи вебхука формы сайта (POST /api/webhook/lead).
# Сгенерировать: openssl rand -hex 32
LEAD_WEBHOOK_SECRET=""

# ─── Прочее ─────────────────────────────────────────────────────────────────
# Часовой пояс отображения. Хранение всегда в UTC, менять без причины не нужно.
DISPLAY_TIMEZONE="Europe/Berlin"

# Отключение анонимной телеметрии Next.js (данные уходят за пределы ЕС).
NEXT_TELEMETRY_DISABLED="1"
