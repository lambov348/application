# Продакшен-окружение. Скопировать в deploy/.env и заполнить.
# Файл содержит секреты — в репозиторий он не попадает (см. .gitignore).

# ─── Домен ──────────────────────────────────────────────────────────────────
# Caddy получит для него сертификат Let's Encrypt автоматически.
# Домен должен уже указывать A-записью на IP сервера.
APP_DOMAIN="platform.example.de"
# Почта для уведомлений Let's Encrypt об истечении сертификата.
ACME_EMAIL="inhaber@example.de"

# ─── Секреты ────────────────────────────────────────────────────────────────
# Сгенерировать каждый своей командой и больше нигде не использовать.
#   openssl rand -hex 24
POSTGRES_PASSWORD=""
#   openssl rand -base64 32
AUTH_SECRET=""
#   openssl rand -base64 32
# ВНИМАНИЕ: при потере этого ключа все настроенные 2FA придётся сбрасывать
# вручную — секреты в базе зашифрованы именно им.
ENCRYPTION_KEY=""

# ─── Сессии ─────────────────────────────────────────────────────────────────
SESSION_MAX_AGE_SECONDS="28800"

# ─── Хранилище файлов ───────────────────────────────────────────────────────
# local — том Docker на этом же сервере, входит в ежедневный бэкап.
# s3 — Hetzner Object Storage; регион обязан быть в ЕС (fsn1, nbg1, hel1).
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="/app/storage"

S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Приём заявок с сайта ───────────────────────────────────────────────────
#   openssl rand -hex 32
LEAD_WEBHOOK_SECRET=""

# ─── Прочее ─────────────────────────────────────────────────────────────────
DISPLAY_TIMEZONE="Europe/Berlin"
NEXT_TELEMETRY_DISABLED="1"
