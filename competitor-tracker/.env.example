# ── Платные / внешние источники данных (все опциональны) ──────────────
# Ядро работает БЕЗ этих ключей. Когда ключ задан — соответствующий
# раздел отчёта наполняется реальными данными вместо заглушки.

# Позиции в поиске по ключевым словам (SERP).
# Регистрация: https://serpapi.com  (есть бесплатный лимит)
SERPAPI_KEY=

# Рекламные креативы конкурента в Meta (Facebook/Instagram).
# Токен: https://www.facebook.com/ads/library/api/
META_AD_LIBRARY_TOKEN=

# Оценка трафика / источников (SimilarWeb-подобные данные).
# Провайдер на ваш выбор — сюда кладётся его ключ.
TRAFFIC_API_KEY=
